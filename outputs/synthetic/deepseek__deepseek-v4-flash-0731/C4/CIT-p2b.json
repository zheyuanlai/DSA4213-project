 "outline": {
  "findings": [
   {
    "finding_id": "F1",
    "summary": "Corbel's zero-shot nDCG@10 average gain over Dovetail-DR (same bi-encoder with standard in-batch negatives) is 4.7 points (40.7 vs 36.0), which is slightly smaller than the 5.2-point gain previously reported for denoised hard-negative mining on a biomedical collection.",
    "evidence_ids": [
     "T1.r3.avg",
     "T1.r2.avg",
     "P1"
    ],
    "scope": "Average nDCG@10 across Brackwater-News, Felloe-Fin, Moorstone-Bio and Lintel-Law; single training run per system; no statistical tests reported.",
    "caveats": "The prior 5.2-point gain was reported for a biomedical collection only, not the average across these four collections; no statistical significance tests were reported for either comparison."
   },
   {
    "finding_id": "F2",
    "summary": "Corbel outperforms Dovetail-DR on all four individual collections, with gains ranging from 2.9 points (Brackwater-News: 43.1 vs 38.4) to 5.9 points (Moorstone-Bio: 50.6 vs 44.7).",
    "evidence_ids": [
     "T1.r3.news",
     "T1.r2.news",
     "T1.r3.fin",
     "T1.r2.fin",
     "T1.r3.bio",
     "T1.r2.bio",
     "T1.r3.law",
     "T1.r2.law"
    ],
    "scope": "nDCG@10 per collection; single training run per system; no statistical tests reported.",
    "caveats": "Gains are descriptive differences; no significance tests were reported."
   },
   {
    "finding_id": "F3",
    "summary": "Corbel also outperforms the lexical reference Lexi-Sparse on average (40.7 vs 35.3) and on all four collections, with the largest gain on Felloe-Fin (35.0 vs 27.9, +7.1 points).",
    "evidence_ids": [
     "T1.r3.avg",
     "T1.r1.avg",
     "T1.r3.news",
