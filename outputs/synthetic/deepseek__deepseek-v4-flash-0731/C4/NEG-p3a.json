     "T1.r1.wist",
     "T1.r3.wist"
    ],
    "scope": "All three test sets (Hollin-DocRE, Saltmarsh-Bio, Wistmoor-News), relation F1 (%), mean over 3 seeds.",
    "caveats": "No statistical tests reported; differences are descriptive only."
   },
   {
    "finding_id": "F2",
    "summary": "The evidence-gating module contributes to performance on the in-domain and biomedical sets: removing it lowers F1 from 65.2 to 63.0 on Hollin-DocRE and from 55.9 to 54.1 on Saltmarsh-Bio, but on Wistmoor-News removing it raises F1 from 71.1 to 72.4, indicating a mixed effect across domains.",
    "evidence_ids": [
     "T1.r2.hollin",
     "T1.r3.hollin",
     "T1.r2.salt",
     "T1.r3.salt",
     "T1.r2.wist",
     "T1.r3.wist"
    ],
    "scope": "Ablation comparison on all three test sets, relation F1 (%), mean over 3 seeds.",
    "caveats": "No statistical tests reported; the Wistmoor-News result is adverse to the module's benefit."
   }
  ]
 },
