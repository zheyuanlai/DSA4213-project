  "findings": [
   {
    "finding_id": "F1",
    "summary": "Corvane-DST achieves higher mean JGA than Halloway-DST on the Merriwold-Dialog 2.0 test set (56.8% vs 56.1%), but no statistical test is reported for this comparison, so the difference is not established as significant.",
    "evidence_ids": [
     "T1.r1.jga",
     "T1.r2.jga"
    ],
    "scope": "Merriwold-Dialog 2.0 test set, JGA, 5 seeds",
    "caveats": "No significance test reported for this specific comparison."
   },
   {
    "finding_id": "F2",
    "summary": "Corvane-DST significantly outperforms Pipkin-Span on the Merriwold-Dialog 2.0 test set (mean difference 4.5 percentage points, 95% CI [3.51, 5.5], p < 0.001).",
    "evidence_ids": [
     "T1.r1.jga",
     "T1.r3.jga",
     "S1"
    ],
    "scope": "Merriwold-Dialog 2.0 test set, JGA, 5 seeds",
    "caveats": ""
   },
   {
    "finding_id": "F3",
    "summary": "On the Tarnby-Schema test set (unseen services), Corvane-DST significantly outperforms Halloway-DST in JGA (mean difference 2.3 percentage points, 95% CI [1.18, 3.42], p = 0.0046).",
    "evidence_ids": [
     "T2.r1.jga",
     "T2.r2.jga",
     "S2"
    ],
    "scope": "Tarnby-Schema test set, JGA, 5 seeds",
    "caveats": "Services unseen in training; secondary evaluation."
   },
   {
    "finding_id": "F4",
    "summary": "Per-domain JGA on single-domain Merriwold-Dialog 2.0 test dialogues shows mixed results: Corvane-DST is higher in train, restaurant, and attraction, but lower in hotel and taxi compared to Halloway-DST.",
    "evidence_ids": [
     "T3.r1.hotel",
     "T3.r1.train",
     "T3.r1.rest",
     "T3.r1.taxi",
     "T3.r1.attr",
     "T3.r2.hotel",
     "T3.r2.train",
     "T3.r2.rest",
