    "caveats": "The effect size is small (0.8 points) and the confidence interval is wide; significance is based on a single test set and one language pair."
   },
   {
    "finding_id": "F2",
    "summary": "Tessaline substantially outperforms the PhraseGrid baseline in BLEU on the same test set, with a statistically significant mean paired difference of 6.3 BLEU points (95% CI [5.87, 6.83], p<0.001, paired t-test over 8 seeds).",
    "evidence_ids": [
     "T1.r1.bleu",
     "T1.r3.bleu",
     "S1"
    ],
    "scope": "Halvard-Parl English→Estonian test set, BLEU, 8 seeds",
    "caveats": "PhraseGrid is a reference baseline, not the primary comparison; result is limited to this test set."
   },
   {
    "finding_id": "F3",
    "summary": "The BLEU advantage of Tessaline over Varrow-NMT is consistent with a small but statistically significant improvement, but the magnitude is modest relative to the gap over the phrase-based baseline.",
    "evidence_ids": [
     "F1",
     "F2"
    ],
    "scope": "Halvard-Parl English→Estonian test set, BLEU",
    "caveats": "No direct statistical comparison between the two differences was performed; interpretation is qualitative."
   }
  ]
